{
  "name": "rhythmhel",
  "productName": "Rhythmhel",
  "version": "1.0.0",
  "description": "Rhythmhel for Windows",
  "main": "main.js",
  "author": "Rhythmhel",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "app.rhythmhel.desktop",
    "productName": "Rhythmhel",
    "files": ["main.js", "offline.html", "icon.png"],
    "win": { "target": ["nsis", "portable"], "icon": "icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "Rhythmhel" },
    "portable": { "artifactName": "Rhythmhel-portable-${version}.exe" }
  }
}
